{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseAddress": "https://hacker-news.firebaseio.com/v0/",
    "CacheDuration": "00:01:00",
    "RetryAfterFailure": "00:00:15",
    "MaxConcurrentRequests": 8,
    "MaxItemFailureRatio": 0.1,
    "WarmUpOnStartup": true,
    "ClientCacheDuration": "00:00:30",
    "StaleAfter": "00:10:00",
    "Resilience": {
      "AttemptTimeout": { "Timeout": "00:00:05" },
      "TotalRequestTimeout": { "Timeout": "00:00:20" },
      "Retry": { "MaxRetryAttempts": 2 },
      "CircuitBreaker": { "FailureRatio": 0.5, "MinimumThroughput": 20, "BreakDuration": "00:00:15" }
    }
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:00:10"
  }
}
